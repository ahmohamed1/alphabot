{
    "configurations": [
        {
            "name": "Arduino Nano",
            "includePath": [
                "${workspaceFolder}",
                "~/.arduino15/packages/arduino/hardware/avr/1.8.7/**"
            ],
            "defines": [
                "__AVR_ATmega328P__",
                "F_CPU=16000000L"
            ],
            "compilerPath": "~/.arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/bin/avr-g++",
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "gcc-x64"
        }
    ],
    "version": 4
}
